{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-writer.local/schemas/delivery/project_release.v2.schema.json",
  "title": "Evidence-to-release quality report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "release_level", "workflow_digest",
    "lineage_digest", "manuscript_sha256", "release_markdown_sha256",
    "chemical_paper_binding_digest", "chemical_paper_safe_summary",
    "chemical_paper_dependency_can_release", "docx_sha256",
    "figure_validation", "integrity"
  ],
  "properties": {
    "schema_version": {"const": "project-release.v2"},
    "status": {"enum": ["SELF_REVIEWED_DRAFT", "EXPERT_REVIEWED_RELEASE"]},
    "release_level": {"enum": ["SELF_REVIEWED_DRAFT", "EXPERT_REVIEWED_RELEASE"]},
    "workflow_digest": {"$ref": "#/$defs/sha256"},
    "lineage_digest": {"$ref": "#/$defs/sha256"},
    "manuscript_sha256": {"$ref": "#/$defs/sha256"},
    "release_markdown_sha256": {"$ref": "#/$defs/sha256"},
    "chemical_paper_binding_digest": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
    },
    "chemical_paper_safe_summary": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/chemical_paper_safe_summary"}]
    },
    "chemical_paper_dependency_can_release": {"type": "boolean"},
    "dual_parse_status": {"const": "current"},
    "dual_parse_binding_digest": {"$ref": "#/$defs/sha256"},
    "reaction_data_status": {"enum": ["available", "unavailable_not_provided"]},
    "reaction_count": {
      "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]
    },
    "credits_status": {"const": "NOT_APPLICABLE_BY_CURRENT_SCOPE"},
    "docx_sha256": {"$ref": "#/$defs/sha256"},
    "figure_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "release_level", "source_figures", "human_synthesis_figures", "required_attributions",
        "expected_media_sha256", "placeholder_count", "pending_placeholder_count"
      ],
      "properties": {
        "schema_version": {"const": "review-writer-figure-validation.v2"},
        "release_level": {"enum": ["SELF_REVIEWED_DRAFT", "EXPERT_REVIEWED_RELEASE"]},
        "source_figures": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "human_synthesis_figures": {"type": "array", "items": {"type": "object"}},
        "required_attributions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "expected_media_sha256": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "placeholder_count": {"type": "integer", "minimum": 0},
        "pending_placeholder_count": {"type": "integer", "minimum": 0}
      }
    },
    "integrity": {"type": "object"}
  },
  "dependentRequired": {
    "dual_parse_status": [
      "dual_parse_binding_digest", "reaction_data_status", "reaction_count",
      "credits_status"
    ],
    "dual_parse_binding_digest": [
      "dual_parse_status", "reaction_data_status", "reaction_count", "credits_status"
    ],
    "reaction_data_status": [
      "dual_parse_status", "dual_parse_binding_digest", "reaction_count", "credits_status"
    ],
    "reaction_count": [
      "dual_parse_status", "dual_parse_binding_digest", "reaction_data_status",
      "credits_status"
    ],
    "credits_status": [
      "dual_parse_status", "dual_parse_binding_digest", "reaction_data_status",
      "reaction_count"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reaction_data_status": {"const": "unavailable_not_provided"}
        },
        "required": ["reaction_data_status"]
      },
      "then": {"properties": {"reaction_count": {"type": "null"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chemical_paper_safe_summary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "route", "study_count", "molecule_count",
        "unresolved_field_count", "element_review_counts", "reaction_data_status"
      ],
      "properties": {
        "schema_version": {"const": "chemical-paper-safe-summary.v1"},
        "route": {"const": "chemical-paper-zip-only"},
        "study_count": {"type": "integer", "minimum": 1},
        "molecule_count": {"type": "integer", "minimum": 0},
        "unresolved_field_count": {"type": "integer", "minimum": 0},
        "element_review_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["not_reviewed", "confirmed", "corrected", "not_applicable"],
          "properties": {
            "not_reviewed": {"type": "integer", "minimum": 0},
            "confirmed": {"type": "integer", "minimum": 0},
            "corrected": {"type": "integer", "minimum": 0},
            "not_applicable": {"type": "integer", "minimum": 0}
          }
        },
        "reaction_data_status": {"enum": ["available", "unavailable_not_provided"]}
      }
    }
  }
}
