{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-writer.local/schemas/quality/standard_corpus_manifest.v1.schema.json",
  "title": "Archived review standard corpus manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "source_zip",
    "source_zip_sha256",
    "pdf_count",
    "mineru_success_count",
    "mineru_failure_count",
    "file_count",
    "files"
  ],
  "properties": {
    "schema_version": {"const": "standard-corpus-manifest.v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_zip": {"$ref": "#/$defs/file"},
    "source_zip_sha256": {"$ref": "#/$defs/sha256"},
    "pdf_count": {"type": "integer", "minimum": 1},
    "mineru_success_count": {"type": "integer", "minimum": 1},
    "mineru_failure_count": {"type": "integer", "minimum": 0},
    "file_count": {"type": "integer", "minimum": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "portable_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/portable_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
