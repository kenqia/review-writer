{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-writer.local/schemas/agents/content_agent_request.v1.schema.json",
  "title": "Bounded Content Agent request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_kind", "project_id", "target_ids", "reason"],
  "properties": {
    "schema_version": {"const": "content-agent-request.v1"},
    "request_kind": {"enum": ["paper_evidence", "synthesis_claims", "section_draft"]},
    "project_id": {"$ref": "#/$defs/id"},
    "target_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
    ,"field_dependencies": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["molecule", "smiles", "molblock"]}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"request_kind": {"const": "paper_evidence"}}},
      "else": {"properties": {"field_dependencies": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!\\.\\.?$)(?!.*[/\\\\\\u0000\\r\\n])[^\\s]+$"
    }
  }
}
