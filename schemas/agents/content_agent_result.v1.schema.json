{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-writer.local/schemas/agents/content_agent_result.v1.schema.json",
  "title": "Bounded Content Agent result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_kind", "project_id", "target_ids",
    "task_package_digest", "agent_label", "content", "result_digest"
  ],
  "properties": {
    "schema_version": {"const": "content-agent-result.v1"},
    "request_kind": {"enum": ["paper_evidence", "synthesis_claims", "section_draft"]},
    "project_id": {"$ref": "#/$defs/id"},
    "target_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "task_package_digest": {"$ref": "#/$defs/sha256"},
    "agent_label": {"type": "string", "minLength": 1, "maxLength": 200},
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_candidates": {"type": "array", "items": {"type": "object"}},
        "source_figure_suggestions": {"type": "array", "items": {"type": "object"}},
        "comparison_protocol": {"type": ["object", "null"]},
        "coverage_map": {"type": ["object", "null"]},
        "synthesis_claims": {"type": "array", "items": {"type": "object"}},
        "section_contracts": {"type": "array", "items": {"type": "object"}}
      }
    },
    "result_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {
      "type": "string", "minLength": 1, "maxLength": 240,
      "pattern": "^(?!\\.\\.?$)(?!.*[/\\\\\\u0000\\r\\n])[^\\s]+$"
    }
  }
}
