{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-writer.local/schemas/agents/content_agent_result.v1.schema.json",
  "title": "Bounded Content Agent result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_kind", "project_id", "target_ids",
    "task_package_digest", "agent_label", "content", "result_digest"
  ],
  "properties": {
    "schema_version": {"const": "content-agent-result.v1"},
    "request_kind": {"enum": ["paper_evidence", "chemical_completion_candidates", "synthesis_claims", "section_draft"]},
    "project_id": {"$ref": "#/$defs/id"},
    "target_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "task_package_digest": {"$ref": "#/$defs/sha256"},
    "agent_label": {"type": "string", "minLength": 1, "maxLength": 200},
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_candidates": {"type": "array", "items": {"type": "object"}},
        "chemical_completion_candidates": {
          "type": "array",
          "items": {"$ref": "#/$defs/chemical_completion_candidate"}
        },
        "source_figure_suggestions": {"type": "array", "items": {"type": "object"}},
        "comparison_protocol": {"type": ["object", "null"]},
        "coverage_map": {"type": ["object", "null"]},
        "synthesis_claims": {"type": "array", "items": {"type": "object"}},
        "section_contracts": {"type": "array", "items": {"type": "object"}}
      }
    },
    "result_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {
      "type": "string", "minLength": 1, "maxLength": 240,
      "pattern": "^(?!\\.\\.?$)(?!.*[/\\\\\\u0000\\r\\n])[^\\s]+$"
    },
    "chemical_completion_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["study_id", "molecule_index", "field", "value", "confidence", "provenance", "pdf_locator", "reason"],
      "properties": {
        "study_id": {"$ref": "#/$defs/id"},
        "molecule_index": {"type": "integer", "minimum": 0},
        "field": {"const": "resolved_smiles"},
        "value": {"type": "string", "minLength": 1, "maxLength": 20000},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "provenance": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "pdf_locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["page"],
          "properties": {
            "page": {"type": "integer", "minimum": 1},
            "figure_label": {"type": "string", "minLength": 1, "maxLength": 200},
            "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
          }
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 20000}
      }
    }
  }
}
